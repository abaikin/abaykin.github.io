---
// Лаборатория: src/data/laboratory.yaml. Пока status: coming-soon — заголовок, описание и блок «Скоро».
// Структура под будущее наполнение: описание (абзацы через пустую строку), направления, проекты (ссылки на
// src/content/projects/), партнёры, сотрудники (только с их согласия; пустой список не показывается), ссылки.
import { getEntries, getEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Icon from '../../../components/Icon.astro';
import LinkList from '../../../components/LinkList.astro';
import TodoNote from '../../../components/TodoNote.astro';
import { type Lang, langPaths, loc, t } from '../../../i18n';
import { langHref } from '../../../lib/site';

export const getStaticPaths = langPaths;

const lang = Astro.params.lang as Lang;
const entry = await getEntry('laboratory', 'laboratory');
if (!entry) throw new Error('Нет данных src/data/laboratory.yaml');
const lab = entry.data;
const name = loc(lab, 'name', lang)!;
const org = loc(lab, 'org', lang)!;
const unit = loc(lab, 'unit', lang);
const short = loc(lab, 'short', lang);
const description = loc(lab, 'description', lang);
const paragraphs = description ? description.text.split(/\n\s*\n/).map((s) => s.trim()).filter(Boolean) : [];
const projects = await getEntries(lab.projects);
---

<BaseLayout lang={lang} title={t(lang, 'nav.lab')} description={name.text} section="lab">
  <div class="wrap py-12 lg:py-16">
    <p class="eyebrow">{t(lang, 'nav.lab')}</p>
    <h1 class="mt-3 max-w-3xl text-3xl font-semibold sm:text-4xl" lang={name.lang}>{name.text}</h1>
    <p class="mt-3 text-muted">
      <a href={lab.org_url} lang={org.lang}>{org.text}</a>{unit && <span lang={unit.lang}>{`, ${unit.text}`}</span>}
      <span aria-hidden="true"> · </span>
      {t(lang, 'lab.since', { year: lab.since })}
    </p>
    <p class="mt-6 max-w-2xl text-lg">
      {short ? <span lang={short.lang}>{short.text}</span> : <TodoNote lang={lang} text={t(lang, 'lab.descriptionTodo')} />}
    </p>

    {
      paragraphs.length > 0 && (
        <div class="mt-6 max-w-3xl space-y-4 leading-relaxed" lang={description!.lang}>
          {paragraphs.map((s) => (
            <p>{s}</p>
          ))}
        </div>
      )
    }

    {
      lab.directions.length > 0 && (
        <section class="page-section" aria-labelledby="lab-directions">
          <h2 id="lab-directions">{t(lang, 'lab.directions')}</h2>
          <ul class="mt-4 grid gap-4 sm:grid-cols-2">
            {lab.directions.map((d) => {
              const title = loc(d, 'title', lang)!;
              const text = loc(d, 'text', lang);
              return (
                <li class="card flex items-start gap-4 p-5">
                  <span class="icon-circle" aria-hidden="true">
                    <Icon name={`lucide:${d.icon ?? 'sparkles'}`} size={20} />
                  </span>
                  <div>
                    <p class="font-semibold text-heading" lang={title.lang}>
                      {title.text}
                    </p>
                    {text && (
                      <p class="mt-1 text-muted" lang={text.lang}>
                        {text.text}
                      </p>
                    )}
                  </div>
                </li>
              );
            })}
          </ul>
        </section>
      )
    }

    {
      projects.length > 0 && (
        <section class="page-section" aria-labelledby="lab-projects">
          <h2 id="lab-projects">{t(lang, 'lab.projects')}</h2>
          <ul class="mt-3 space-y-3">
            {projects.map((project) => {
              const title = loc(project.data, 'title', lang)!;
              const summary = loc(project.data, 'summary', lang);
              return (
                <li>
                  <a href={langHref(lang, `projects/${project.id}/`)} class="font-semibold" lang={title.lang}>
                    {title.text}
                  </a>
                  {summary && (
                    <p class="text-sm text-muted" lang={summary.lang}>
                      {summary.text}
                    </p>
                  )}
                </li>
              );
            })}
          </ul>
        </section>
      )
    }

    {
      lab.partners.length > 0 && (
        <section class="page-section" aria-labelledby="lab-partners">
          <h2 id="lab-partners">{t(lang, 'lab.partners')}</h2>
          <ul class="mt-3 space-y-1.5">
            {lab.partners.map((partner) => {
              const label = loc(partner, 'name', lang)!;
              return <li lang={label.lang}>{partner.url ? <a href={partner.url}>{label.text}</a> : label.text}</li>;
            })}
          </ul>
        </section>
      )
    }

    {
      lab.people.length > 0 && (
        <section class="page-section" aria-labelledby="lab-people">
          <h2 id="lab-people">{t(lang, 'lab.people')}</h2>
          <ul class="mt-3 space-y-1.5">
            {lab.people.map((person) => {
              const who = loc(person, 'name', lang)!;
              const what = loc(person, 'role', lang);
              return (
                <li>
                  {person.url ? (
                    <a href={person.url} lang={who.lang}>
                      {who.text}
                    </a>
                  ) : (
                    <span lang={who.lang}>{who.text}</span>
                  )}
                  {what && (
                    <span class="text-sm text-subtle" lang={what.lang}>
                      {' · '}
                      {what.text}
                    </span>
                  )}
                </li>
              );
            })}
          </ul>
        </section>
      )
    }

    {
      lab.links.length > 0 && (
        <section class="page-section" aria-labelledby="lab-links">
          <h2 id="lab-links">{t(lang, 'lab.links')}</h2>
          <LinkList lang={lang} links={lab.links} />
        </section>
      )
    }

    {
      lab.status === 'coming-soon' && (
        <div class="card mt-10 flex max-w-2xl items-start gap-4 p-6">
          <span class="icon-circle" aria-hidden="true">
            <Icon name="lucide:clock" size={20} />
          </span>
          <div>
            <p class="font-semibold text-heading">{t(lang, 'lab.soon')}</p>
            <p class="mt-1 text-muted">{t(lang, 'lab.soonText')}</p>
          </div>
        </div>
      )
    }
  </div>
</BaseLayout>
