---
import { getCollection, getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import { type Lang, isFilled, langPaths, loc, t } from '../../i18n';
import { PROFILES, asset, assetExists, langHref } from '../../lib/site';

export const getStaticPaths = langPaths;

const lang = Astro.params.lang as Lang;

const profileEntry = await getEntry('profile', 'profile');
if (!profileEntry) throw new Error('Нет данных src/data/profile.yaml');
const p = profileEntry.data;

const name = loc(p, 'name', lang)!;
const position = loc(p, 'position', lang)!;
const affiliation = loc(p, 'affiliation', lang)!;
const degree = loc(p, 'degree', lang)!;
const bio = loc(p, 'bio', lang)!;
const paragraphs = bio.text
  .split(/\n\s*\n/)
  .map((s) => s.trim())
  .filter(Boolean);

// CV: файл на языке страницы, если он есть; иначе русская версия с пометкой языка
const cvOwn = p.cv[lang];
const cvFile = isFilled(cvOwn) && assetExists(cvOwn) ? cvOwn : assetExists(p.cv.ru) ? p.cv.ru : undefined;
const cvInOtherLang = cvFile !== undefined && cvFile !== cvOwn;

// «Чем занимаюсь»: карточки ведут на проекты и на страницу лаборатории
const labEntry = await getEntry('laboratory', 'laboratory');
if (!labEntry) throw new Error('Нет данных src/data/laboratory.yaml');
const lab = labEntry.data;
const doing = await Promise.all(
  p.doing.map(async (item) => {
    if ('project' in item) {
      const project = await getEntry(item.project);
      if (!project) throw new Error(`Проект не найден: ${item.project.id}`);
      return {
        href: langHref(lang, `projects/${project.id}/`),
        icon: project.data.icon,
        title: loc(project.data, 'title', lang)!,
        text: loc(project.data, 'role', lang),
      };
    }
    return {
      href: langHref(lang, 'lab/'),
      icon: lab.icon,
      title: loc(lab, 'name', lang)!,
      text: loc(lab, 'role', lang),
    };
  }),
);

const education = (await getCollection('education')).sort((a, b) => a.data.end - b.data.end);
const emailLabel = { work: t(lang, 'bio.emailWork'), personal: t(lang, 'bio.emailPersonal') };
---

<BaseLayout lang={lang} section="bio">
  <section class="hero border-b border-border">
    <div class="wrap grid gap-10 py-12 lg:grid-cols-[18rem_minmax(0,1fr)] lg:gap-14 lg:py-16">
      <div class="text-center">
        <Image
          src={p.photo}
          alt={name.text}
          width={384}
          height={384}
          widths={[160, 192, 320, 384]}
          sizes="(min-width: 1024px) 192px, 160px"
          class="mx-auto size-40 rounded-full object-cover shadow-xl ring-4 ring-[var(--c-ring)] lg:size-48"
          loading="eager"
          fetchpriority="high"
        />
        <h1 class="mt-6 text-[1.9rem] font-semibold sm:text-[2.1rem]" lang={name.lang}>{name.text}</h1>
        <p class="mt-2 text-muted" lang={degree.lang}>{degree.text}</p>
        <p class="mt-3 font-medium leading-snug" lang={position.lang}>{position.text}</p>
        <p class="mt-1"><a href={p.affiliation_url} lang={affiliation.lang}>{affiliation.text}</a></p>
        <ul class="mt-6 flex flex-wrap justify-center gap-2.5" aria-label={t(lang, 'bio.profiles')}>
          {
            p.profiles.map((pr) => {
              const meta = PROFILES[pr.id] ?? { icon: 'lucide:external-link', label: { ru: pr.id, en: pr.id } };
              return (
                <li>
                  <a class="profile-btn" href={pr.url} rel="me" title={meta.label[lang]} aria-label={meta.label[lang]}>
                    <Icon name={meta.icon} size={20} />
                  </a>
                </li>
              );
            })
          }
        </ul>
      </div>

      <div class="min-w-0">
        <section aria-labelledby="about">
          <SectionHeading icon="lucide:id-card" id="about">{t(lang, 'bio.about')}</SectionHeading>
          <div class="max-w-3xl space-y-4 leading-relaxed" lang={bio.lang}>
            {paragraphs.map((para) => <p>{para}</p>)}
          </div>

          {
            cvFile && (
              <p class="mt-8">
                <a class="btn-gradient" href={asset(cvFile)}>
                  <Icon name="lucide:download" size={20} />
                  {t(lang, 'bio.downloadCv')}
                  <span class="text-sm font-normal opacity-90">
                    PDF{cvInOtherLang ? `, ${t(lang, 'bio.cvInLang')}` : ''}
                  </span>
                </a>
              </p>
            )
          }

          <div class="mt-8">
            <h3 class="flex items-center gap-2 text-base font-semibold text-heading">
              <Icon name="lucide:mail" size={18} />
              {t(lang, 'bio.contacts')}
            </h3>
            <ul class="mt-2 space-y-1">
              {
                p.emails.map((e) => (
                  <li>
                    <a href={`mailto:${e.address}`}>{e.address}</a>
                    <span class="text-subtle"> — {emailLabel[e.kind]}</span>
                  </li>
                ))
              }
            </ul>
          </div>
        </section>

        <section class="mt-12" aria-labelledby="interests">
          <SectionHeading icon="lucide:sparkles" id="interests">{t(lang, 'bio.interests')}</SectionHeading>
          <ul class="flex flex-wrap gap-2">
            {p.interests.map((i) => <li class="chip">{i[lang]}</li>)}
          </ul>
        </section>
      </div>
    </div>
  </section>

  <section class="wrap py-14" aria-labelledby="doing">
    <SectionHeading icon="lucide:briefcase" id="doing">{t(lang, 'bio.doing')}</SectionHeading>
    <ul class="grid gap-5 md:grid-cols-2">
      {
        doing.map((d) => (
          <li>
            <a href={d.href} class="card card-link group flex h-full gap-4 p-5">
              <span class="icon-circle" aria-hidden="true">
                <Icon name={`lucide:${d.icon}`} size={20} />
              </span>
              <span class="min-w-0">
                <span class="block font-heading text-lg font-semibold text-heading group-hover:text-primary" lang={d.title.lang}>
                  {d.title.text}
                </span>
                {d.text && (
                  <span class="mt-1 block text-muted" lang={d.text.lang}>
                    {d.text.text}
                  </span>
                )}
                <span class="mt-3 inline-flex items-center gap-1 text-sm font-semibold text-primary">
                  {t(lang, 'common.more')}
                  <Icon name="lucide:arrow-right" size={15} />
                </span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="wrap pb-4" aria-labelledby="education">
    <SectionHeading icon="lucide:graduation-cap" id="education">{t(lang, 'bio.education')}</SectionHeading>
    <ul class="grid gap-5 md:grid-cols-3">
      {
        education.map((e) => {
          const d = e.data;
          const deg = loc(d, 'degree', lang)!;
          const program = loc(d, 'program', lang)!;
          const org = loc(d, 'org_short', lang)!;
          return (
            <li class="card flex h-full flex-col p-5">
              <p class="eyebrow">{d.end}</p>
              <h3 class="mt-2 text-lg font-semibold" lang={deg.lang}>
                {deg.text}
              </h3>
              <p class="mt-1 text-muted" lang={program.lang}>
                {program.text}
              </p>
              <p class="mt-3 text-sm text-subtle" lang={org.lang}>
                {org.text}
              </p>
              {d.honors && (
                <p class="mt-auto pt-4">
                  <span class="chip chip-sm">{t(lang, 'common.honors')}</span>
                </p>
              )}
            </li>
          );
        })
      }
    </ul>
    <p class="mt-5">
      <a href={langHref(lang, 'experience/#education')} class="inline-flex items-center gap-1 text-sm font-semibold">
        {t(lang, 'bio.educationMore')}
        <Icon name="lucide:arrow-right" size={15} />
      </a>
    </p>
  </section>
</BaseLayout>
