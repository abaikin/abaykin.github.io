---
import { getCollection, getEntries, getEntry } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Icon from '../../../components/Icon.astro';
import TodoNote from '../../../components/TodoNote.astro';
import { type Lang, LANGS, loc, t } from '../../../i18n';
import { langHref } from '../../../lib/site';
import { comparePubs, displayAuthors, isOwner, ownerFamilies, texHtml, venueLine } from '../../../lib/publications';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return LANGS.flatMap((lang) =>
    projects.map((project) => ({ params: { lang, slug: project.id }, props: { project } })),
  );
}

const lang = Astro.params.lang as Lang;
const { project } = Astro.props as { project: CollectionEntry<'projects'> };
const p = project.data;
const title = loc(p, 'title', lang)!;
const role = loc(p, 'role', lang);
const summary = loc(p, 'summary', lang);
const tags = await getEntries(p.tags);

// Связанные публикации и выступления (ключи из publications.bib и id из src/content/talks/)
const publications = (await getEntries(p.publications)).sort(comparePubs);
const talks = await getEntries(p.talks);
const profile = (await getEntry('profile', 'profile'))!.data;
const owners = ownerFamilies([profile.name_ru, profile.name_en, ...profile.alt_names]);

const period =
  p.start === undefined || p.start === 'TODO'
    ? undefined
    : p.end
      ? `${p.start}–${p.end}`
      : p.status === 'active'
        ? `${p.start} — ${t(lang, 'common.present')}`
        : String(p.start);
---

<BaseLayout lang={lang} title={title.text} description={summary?.text} section="projects">
  <article class="wrap py-12 lg:py-16">
    <a href={langHref(lang, 'projects/')} class="inline-flex items-center gap-1 text-sm font-semibold">
      <Icon name="lucide:arrow-left" size={15} />
      {t(lang, 'projects.all')}
    </a>

    <div class="mt-6 flex max-w-4xl items-start gap-4">
      <span class="icon-circle mt-1" aria-hidden="true"><Icon name={`lucide:${p.icon}`} size={20} /></span>
      <h1 class="text-3xl font-semibold sm:text-4xl" lang={title.lang}>{title.text}</h1>
    </div>

    <dl class="mt-6 grid max-w-4xl gap-x-6 gap-y-2 sm:grid-cols-[max-content_1fr]">
      <dt class="text-subtle">{t(lang, 'projects.role')}</dt>
      <dd>{role ? <span lang={role.lang}>{role.text}</span> : <TodoNote lang={lang} />}</dd>
      <dt class="text-subtle">{t(lang, 'projects.period')}</dt>
      <dd>
        {period ?? <TodoNote lang={lang} />}
        <span class="text-subtle"> · {t(lang, p.status === 'active' ? 'projects.status.active' : 'projects.status.completed')}</span>
      </dd>
    </dl>

    {
      tags.length > 0 && (
        <ul class="mt-5 flex flex-wrap gap-1.5">
          {tags.map((tag) => (
            <li class="chip chip-sm">{tag.data[lang]}</li>
          ))}
        </ul>
      )
    }

    {summary && <p class="mt-8 max-w-3xl text-lg leading-relaxed" lang={summary.lang}>{summary.text}</p>}

    <p class="mt-6"><TodoNote lang={lang} text={t(lang, 'projects.detailsTodo')} /></p>

    {
      publications.length > 0 && (
        <section class="mt-10 max-w-4xl" aria-labelledby="project-publications">
          <h2 id="project-publications" class="text-xl font-semibold">
            {t(lang, 'projects.publications')}
          </h2>
          <ul class="mt-3 divide-y divide-border">
            {publications.map((pub) => (
              <li class="py-3">
                <a href={langHref(lang, `publications/#${pub.id}`)} class="font-semibold" lang={pub.data.lang} set:html={texHtml(pub.data.title)} />
                <p class="mt-0.5 text-sm text-muted">
                  {displayAuthors(pub.data, lang).map((n, i) => (
                    <Fragment>
                      {i > 0 && ', '}
                      {isOwner(n, owners) ? <strong class="pub-owner">{`${n.family} ${n.given}`}</strong> : `${n.family} ${n.given}`}
                    </Fragment>
                  ))}
                </p>
                <p class="text-sm text-subtle italic">{venueLine(pub.data, lang)}</p>
              </li>
            ))}
          </ul>
          <p class="mt-3">
            <a href={langHref(lang, 'publications/')} class="inline-flex items-center gap-1 text-sm font-semibold">
              {t(lang, 'projects.allPublications')}
              <Icon name="lucide:arrow-right" size={15} />
            </a>
          </p>
        </section>
      )
    }

    {
      talks.length > 0 && (
        <section class="mt-10 max-w-4xl" aria-labelledby="project-talks">
          <h2 id="project-talks" class="text-xl font-semibold">
            {t(lang, 'projects.talks')}
          </h2>
          <ul class="mt-3 space-y-2">
            {talks.map((talk) => {
              const title = loc(talk.data, 'title', lang)!;
              const event = loc(talk.data, 'event', lang);
              return (
                <li>
                  <a href={langHref(lang, `talks/#${talk.id}`)} lang={title.lang}>
                    {title.text}
                  </a>
                  <span class="text-sm text-subtle">
                    {' '}
                    · {talk.data.date.slice(0, 4)}
                    {event && <span lang={event.lang}> · {event.text}</span>}
                  </span>
                </li>
              );
            })}
          </ul>
        </section>
      )
    }

    {
      p.links.length > 0 && (
        <section class="mt-10" aria-labelledby="links">
          <h2 id="links" class="text-xl font-semibold">
            {t(lang, 'projects.links')}
          </h2>
          <ul class="mt-3 space-y-1">
            {p.links.map((l) => (
              <li>
                <a href={l.url} class="inline-flex items-center gap-1.5">
                  {l.label}
                  <Icon name="lucide:external-link" size={14} />
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </article>
</BaseLayout>
