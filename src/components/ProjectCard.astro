---
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
import TodoNote from './TodoNote.astro';
import { type Lang, type UIKey, loc, t } from '../i18n';
import { langHref } from '../lib/site';
import { entryPeriod, techLabel } from '../lib/projects';

// Карточка проекта в списке (референс 4): заголовок, роль, период и статус, кратко, теги, «Подробнее».
// Это запись списка для scripts/list-page.ts: data-f-status и data-f-tag — значения фильтров, data-alt — текст для поиска.
interface Props {
  lang: Lang;
  project: CollectionEntry<'projects'>;
  tagLabels: Map<string, string>;
}

const { lang, project, tagLabels } = Astro.props;
const p = project.data;
const url = langHref(lang, `projects/${project.id}/`);
const title = loc(p, 'title', lang)!;
const role = loc(p, 'role', lang);
const summary = loc(p, 'summary', lang);
const period = entryPeriod(p, lang);
const tagIds = p.tags.map((ref) => ref.id);
const alt = [p.title_ru, p.title_en, p.summary_ru, p.summary_en, ...p.technologies.map((x) => techLabel(x, lang))].join(' ');
---

<li class="project-item" data-item data-f-status={p.status} data-f-tag={tagIds.join(' ')} data-alt={alt}>
  <article class="flex gap-4">
    <span class="icon-circle mt-1" aria-hidden="true"><Icon name={`lucide:${p.icon}`} size={20} /></span>
    <div class="min-w-0 flex-1">
      <h2 id={project.id} class="text-xl font-semibold">
        <a href={url} class="text-heading no-underline hover:text-primary hover:underline" lang={title.lang}>{title.text}</a>
      </h2>
      <p class="mt-1.5 flex flex-wrap gap-x-4 gap-y-1 text-sm text-subtle">
        <span class="inline-flex items-center gap-1.5">
          <Icon name="lucide:user" size={15} />
          {role ? <span lang={role.lang}>{role.text}</span> : <TodoNote lang={lang} />}
        </span>
        <span class="inline-flex items-center gap-1.5">
          <Icon name="lucide:calendar" size={15} />
          {period ?? <TodoNote lang={lang} />}
        </span>
        <span class="inline-flex items-center gap-1.5">
          <Icon name={p.status === 'active' ? 'lucide:activity' : 'lucide:circle-check'} size={15} />
          {t(lang, `projects.state.${p.status}` as UIKey)}
        </span>
      </p>
      {summary && <p class="mt-2.5 text-muted" lang={summary.lang}>{summary.text}</p>}
      {
        tagIds.length > 0 && (
          <ul class="mt-2.5 flex flex-wrap gap-1.5" aria-label={t(lang, 'pubs.filterTags')}>
            {tagIds.map((id) => (
              <li>
                <a class="chip chip-sm chip-link" href={`?tag=${id}`} data-tag={id}>
                  {tagLabels.get(id) ?? id}
                </a>
              </li>
            ))}
          </ul>
        )
      }
      <a href={url} class="pub-btn mt-3 w-fit">
        {t(lang, 'common.more')}
        <Icon name="lucide:arrow-right" size={14} />
      </a>
    </div>
  </article>
</li>
