---
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
import TodoNote from './TodoNote.astro';
import { type Lang, type UIKey, loc, t } from '../i18n';
import { langHref } from '../lib/site';
import { entryPeriod } from '../lib/projects';

// Карточка курса: вид и место, название, роль, когда читался, язык, кратко, «Подробнее»
interface Props {
  lang: Lang;
  course: CollectionEntry<'courses'>;
}

const { lang, course } = Astro.props;
const c = course.data;
const url = langHref(lang, `courses/${course.id}/`);
const title = loc(c, 'title', lang)!;
const org = loc(c, 'org', lang)!;
const role = loc(c, 'role', lang);
const summary = loc(c, 'summary', lang);
const period = entryPeriod(c, lang);
---

<li id={course.id} class="card flex flex-col p-6">
  <div class="flex items-start gap-4">
    <span class="icon-circle" aria-hidden="true"><Icon name={`lucide:${c.icon}`} size={20} /></span>
    <div class="min-w-0 flex-1">
      <p class="text-sm text-subtle">
        {t(lang, `courses.kind.${c.kind}` as UIKey)} · <span lang={org.lang}>{org.text}</span>
      </p>
      <h2 class="mt-1 text-xl font-semibold">
        <a href={url} class="text-heading no-underline hover:text-primary hover:underline" lang={title.lang}>{title.text}</a>
      </h2>
    </div>
  </div>
  <p class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-sm text-subtle">
    <span class="inline-flex items-center gap-1.5">
      <Icon name="lucide:user" size={15} />
      {role ? <span lang={role.lang}>{role.text}</span> : <TodoNote lang={lang} />}
    </span>
    <span class="inline-flex items-center gap-1.5">
      <Icon name="lucide:calendar" size={15} />
      {period ?? <TodoNote lang={lang} />}
    </span>
    <span class="inline-flex items-center gap-1.5">
      <Icon name="lucide:languages" size={15} />
      {t(lang, `courses.lang.${c.language}` as UIKey)}
    </span>
  </p>
  {summary && <p class="mt-3 text-muted" lang={summary.lang}>{summary.text}</p>}
  <div class="mt-auto pt-4">
    <a href={url} class="pub-btn w-fit">
      {t(lang, 'common.more')}
      <Icon name="lucide:arrow-right" size={14} />
    </a>
  </div>
</li>
