---
// Одна публикация в списке: название, авторы, выходные данные, индексация, теги,
// кнопки (Подробнее, DOI, arXiv, PDF, Доклад, BibTeX, Цитировать) и раскрывающаяся аннотация.
// Если у статьи есть переводная версия (или оригинал), она показывается отдельной строкой под выходными данными.
import Icon from './Icon.astro';
import { type Lang, type UIKey, t } from '../i18n';
import { asset, assetExists } from '../lib/site';
import {
  type Journal,
  type Pub,
  citation,
  displayAuthors,
  indexBadges,
  isOwner,
  normalize,
  texHtml,
  translit,
  venueLine,
} from '../lib/publications';

export interface RelatedLink {
  title: string;
  lang: Lang;
  href: string;
}

interface Props {
  lang: Lang;
  pub: Pub;
  journal?: Journal;
  owners: Set<string>;
  tagLabels: Map<string, string>;
  projects?: RelatedLink[];
  talks?: RelatedLink[];
  /** Вторая версия статьи: перевод (isTranslation) или оригинал */
  alternate?: { pub: Pub; journal?: Journal; isTranslation: boolean };
}

const { lang, pub, journal, owners, tagLabels, projects = [], talks = [], alternate } = Astro.props;
const d = pub.data;
const id = pub.id;
const auto = d.translation === 'auto';
const tr = (key: string, vars?: Record<string, string | number>) => t(lang, key as UIKey, vars);

// Название: оригинал + перевод на язык страницы (если вторая версия на языке страницы не показана отдельно)
const translatedTitle = d.lang !== lang && !alternate ? (lang === 'ru' ? d.title_ru : d.title_en) : undefined;

// Авторы: длинный список сокращаем, владелец сайта виден всегда
const names = displayAuthors(d, lang);
const LIMIT = 10;
const ownerIndex = names.findIndex((n) => isOwner(n, owners));
const shortList =
  names.length > LIMIT
    ? [...names.slice(0, 3).map((n, i) => ({ n, i })), ...(ownerIndex >= 3 ? [{ n: names[ownerIndex], i: ownerIndex }] : [])]
    : names.map((n, i) => ({ n, i }));
const hiddenCount = names.length - shortList.length;

// Индексация: у записи и у её второй версии (для фильтра учитываются обе)
const badges = indexBadges(d, journal, lang, tr);
const altBadges = alternate ? indexBadges(alternate.pub.data, alternate.journal, lang, tr) : [];
const indexKeys = [...new Set([...badges, ...altBadges].map((b) => b.key))];
const tagIds = [...new Set([...d.tags, ...(alternate?.pub.data.tags ?? [])].map((tag) => tag.id))];

// Ссылки
const fipsLink = d.url?.includes('fips.ru');
const pdfPath = d.fulltext ?? `pdf/papers/${id}.pdf`;
const pdf = assetExists(pdfPath) ? asset(pdfPath) : undefined;
const cite = citation(d, lang);

// Подробности: аннотация на языке страницы (оригинал или перевод), полный список авторов, примечание, связи
const ownAbstract = d.lang === lang ? d.abstract : lang === 'ru' ? d.abstract_ru : d.abstract_en;
const isTranslation = d.lang !== lang && Boolean(ownAbstract);
const abstract = ownAbstract ?? d.abstract;
const abstractLang = ownAbstract ? lang : d.lang;
const note = (lang === 'ru' ? d.note_ru : d.note_en) ?? (lang === 'ru' ? d.note : undefined);
const hasDetails = Boolean(abstract || hiddenCount > 0 || note || projects.length || talks.length);

// Дополнительный текст для поиска: латиница для кириллических авторов и название на втором языке
const alt = normalize(
  [...d.authors.map((a) => translit(a)), ...d.authors_en, lang === 'ru' ? d.title_en : d.title_ru, d.journal_en, d.doi, alternate?.pub.data.doi]
    .filter(Boolean)
    .join(' '),
);
---

<li class="pub" data-item data-f-type={d.category} data-f-index={indexKeys.join(' ')} data-f-tag={tagIds.join(' ')} data-alt={alt}>
  <article>
    {alternate && <span id={alternate.pub.id} class="pub-anchor" aria-hidden="true" />}
    <p class="pub-kind">
      {tr(`pubs.kind.${d.kind}`)}
      {d.author_order_todo && <span class="todo-note ml-2">{tr('pubs.authorOrderTodo')}</span>}
    </p>
    <h3 id={id} class="pub-title" lang={d.lang} set:html={texHtml(d.title)} />
    {
      translatedTitle && (
        <p class="pub-subtitle" lang={lang}>
          <span set:html={texHtml(translatedTitle)} />
          {auto && <span class="mt-note">{tr('common.autoTranslation')}</span>}
        </p>
      )
    }
    <p class="pub-authors">
      {
        shortList.map(({ n, i }, k) => (
          <Fragment>
            {k > 0 && (i - shortList[k - 1].i > 1 ? ', …, ' : ', ')}
            {isOwner(n, owners) ? <strong class="pub-owner">{`${n.family} ${n.given}`}</strong> : `${n.family} ${n.given}`}
          </Fragment>
        ))
      }
      {hiddenCount > 0 && <span class="text-subtle"> {tr('pubs.andMore', { n: hiddenCount })}</span>}
    </p>
    <p class="pub-venue">{venueLine(d, lang)}</p>

    {
      alternate && (
        <div class="pub-alt">
          <span class="pub-alt-label">{tr(alternate.isTranslation ? 'pubs.altTranslation' : 'pubs.altOriginal')}</span>
          <span class="pub-alt-title" lang={alternate.pub.data.lang} set:html={texHtml(alternate.pub.data.title)} />
          <span class="pub-alt-venue">{venueLine(alternate.pub.data, lang)}</span>
          <span class="pub-alt-meta">
            {altBadges.map((b) =>
              b.href ? (
                <a class="badge badge-link" href={b.href} title={b.title}>
                  {b.label}
                </a>
              ) : (
                <span class="badge" title={b.title}>
                  {b.label}
                </span>
              ),
            )}
            {alternate.pub.data.doi && (
              <a class="pub-btn pub-btn-sm" href={`https://doi.org/${alternate.pub.data.doi}`}>
                DOI
              </a>
            )}
            {!alternate.pub.data.doi && alternate.pub.data.url && (
              <a class="pub-btn pub-btn-sm" href={alternate.pub.data.url}>
                {tr('pubs.webPage')}
              </a>
            )}
            <button type="button" class="pub-btn pub-btn-sm" data-copy-text={alternate.pub.data.bibtex} title={tr('pubs.copyBibtex')}>
              {tr('pubs.bibtex')}
            </button>
          </span>
        </div>
      )
    }

    {
      (badges.length > 0 || d.tags.length > 0) && (
        <ul class="pub-badges">
          {badges.map((b) =>
            b.href ? (
              <li>
                <a class="badge badge-link" href={b.href} title={b.title}>
                  {b.label}
                </a>
              </li>
            ) : (
              <li class="badge" title={b.title}>
                {b.label}
              </li>
            ),
          )}
          {d.tags.map((tag) => (
            <li>
              <a class="chip chip-sm chip-link" href={`?tag=${tag.id}`} data-tag={tag.id}>
                {tagLabels.get(tag.id) ?? tag.id}
              </a>
            </li>
          ))}
        </ul>
      )
    }

    <div class="pub-actions">
      {
        hasDetails && (
          <button
            type="button"
            class="pub-btn"
            data-toggle
            aria-expanded="false"
            aria-controls={`${id}-details`}
            data-label-open={tr('pubs.details')}
            data-label-close={tr('pubs.hide')}
          >
            <Icon name="lucide:chevron-down" size={15} class="pub-chevron" />
            <span data-label>{tr('pubs.details')}</span>
          </button>
        )
      }
      {d.doi && <a class="pub-btn" href={`https://doi.org/${d.doi}`}>DOI</a>}
      {
        d.url && !d.doi && (
          <a class="pub-btn" href={d.url}>
            {fipsLink ? tr('pubs.fips') : tr('pubs.webPage')}
          </a>
        )
      }
      {d.eprint && d.eprinttype === 'arxiv' && <a class="pub-btn" href={`https://arxiv.org/abs/${d.eprint}`}>arXiv</a>}
      {d.eprint && d.eprinttype === 'ssrn' && <a class="pub-btn" href={`https://ssrn.com/abstract=${d.eprint}`}>SSRN</a>}
      {
        pdf && (
          <a class="pub-btn" href={pdf}>
            <Icon name="lucide:file-text" size={14} /> {tr('pubs.pdf')}
          </a>
        )
      }
      {
        talks.length > 0 && (
          <a class="pub-btn" href={talks[0].href}>
            <Icon name="lucide:presentation" size={14} /> {tr('pubs.talk')}
          </a>
        )
      }
      <button type="button" class="pub-btn" data-copy-text={d.bibtex} title={tr('pubs.copyBibtex')}>
        <Icon name="lucide:braces" size={14} /> {tr('pubs.bibtex')}
      </button>
      <button
        type="button"
        class="pub-btn"
        data-copy-text={cite.text}
        data-copy-html={cite.html.includes('<') ? cite.html : undefined}
        title={tr('pubs.copyCite')}
      >
        <Icon name="lucide:quote" size={14} /> {tr('pubs.cite')}
      </button>
    </div>

    {
      hasDetails && (
        <div id={`${id}-details`} class="pub-details" hidden>
          {abstract && (
            <section>
              <h4 class="pub-dt">
                {tr('pubs.abstract')}
                {isTranslation && auto && <span class="mt-note">{tr('common.autoTranslation')}</span>}
                {!ownAbstract && <span class="mt-note">{tr('common.textInOtherLang')}</span>}
              </h4>
              <div class="pub-abstract" lang={abstractLang} set:html={texHtml(abstract, true)} />
              {isTranslation && d.abstract && (
                <details class="pub-original">
                  <summary>{tr('pubs.abstractOriginal')}</summary>
                  <div class="pub-abstract" lang={d.lang} set:html={texHtml(d.abstract, true)} />
                </details>
              )}
            </section>
          )}
          {hiddenCount > 0 && (
            <section>
              <h4 class="pub-dt">{tr('pubs.authors')}</h4>
              <p>
                {names.map((n, i) => (
                  <Fragment>
                    {i > 0 && ', '}
                    {isOwner(n, owners) ? <strong class="pub-owner">{`${n.family} ${n.given}`}</strong> : `${n.family} ${n.given}`}
                  </Fragment>
                ))}
              </p>
            </section>
          )}
          {note && <p class="text-muted">{note}</p>}
          {projects.length > 0 && (
            <section>
              <h4 class="pub-dt">{tr('pubs.projects')}</h4>
              <ul class="pub-related">
                {projects.map((p) => (
                  <li>
                    <a href={p.href} lang={p.lang}>
                      {p.title}
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )}
          {talks.length > 0 && (
            <section>
              <h4 class="pub-dt">{tr('pubs.talks')}</h4>
              <ul class="pub-related">
                {talks.map((p) => (
                  <li>
                    <a href={p.href} lang={p.lang}>
                      {p.title}
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )}
        </div>
      )
    }
  </article>
</li>
