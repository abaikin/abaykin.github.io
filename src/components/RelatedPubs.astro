---
// Связанные публикации (страницы проекта и курса): название — ссылка на запись в «Публикациях», авторы, выходные данные
import { type Lang } from '../i18n';
import { langHref } from '../lib/site';
import { type Pub, displayAuthors, isOwner, texHtml, venueLine } from '../lib/publications';

interface Props {
  lang: Lang;
  pubs: Pub[];
  /** Фамилии владельца сайта (ownerFamilies) — выделяются в списке авторов */
  owners: Set<string>;
}

const { lang, pubs, owners } = Astro.props;
---

<ul class="mt-3 divide-y divide-border">
  {
    pubs.map((pub) => (
      <li class="py-3">
        <a href={langHref(lang, `publications/#${pub.id}`)} class="font-semibold" lang={pub.data.lang} set:html={texHtml(pub.data.title)} />
        <p class="mt-0.5 text-sm text-muted">
          {displayAuthors(pub.data, lang).map((n, i) => (
            <Fragment>
              {i > 0 && ', '}
              {isOwner(n, owners) ? <strong class="pub-owner">{`${n.family} ${n.given}`}</strong> : `${n.family} ${n.given}`}
            </Fragment>
          ))}
        </p>
        <p class="text-sm text-subtle italic">{venueLine(pub.data, lang)}</p>
      </li>
    ))
  }
</ul>
