  langid       = {russian},
  keywords     = {hydraulic-fracturing, proppant-transport, wellbore-flow},
  abstract     = {Изобретение относится к области технологий добычи углеводородов, в частности к оптимизации параметров, оказывающих непосредственное влияние на повышение продуктивности скважины при проведении гидравлического разрыва пласта (ГРП). Техническим результатом является получение наиболее оптимальных параметров проведения ГРП для увеличения добычи углеводородов и повышение дебита скважин на месторождении, обеспечение проведения ГРП. Согласно способу получают данные по скважине и данные о пласте. Задают данные о жидкости ГРП, данные о проппанте, данные о кислотах, данные о проведении ГРП. С помощью данных по скважине, данных о жидкости ГРП, данных о проппанте, данных о проведении ГРП определяется движение жидкости ГРП в скважине, при которой определяется общий расход жидкости ГРП с кислотой и проппантом, концентрация проппанта в перфорационной зоне скважины и температура жидкости ГРП в перфорационной зоне скважины. Формируют картину роста трещин ГРП в результате итерационного изменения данных о жидкости ГРП и/или данных о проппанте и/или данных о кислотах и/или данных о проведении ГРП и определяют максимальную проводимость трещин ГРП. При этом: определяется распределение потоков жидкости ГРП с кислотой и распределение проппантов в трещинах. Определяется раскрытие трещины и давление жидкости ГРП с проппантом и кислотой. Определяется положение и скорость фронта трещины. Определяется распределение концентрации жидкости ГРП и проппанта в трещине ГРП, температура жидкости ГРП в трещине, толщина породы, вступившей в реакцию с кислотой. Определяются поля дополнительных сжимающих напряжений для каждой трещины. Проводят ГРП на скважине по оптимальным данным о жидкости ГРП, оптимальным данным о проппанте, оптимальным данным о кислотах и оптимальным данным о проведении ГРП, полученным при формировании картины роста трещин ГРП и соответствующим максимальной проводимости трещин ГРП. 3 н. и 7 з.п. ф-лы, 22 ил.},
  title_en     = {Method for determining hydraulic fracture geometry accounting for the splitting and interaction of fracturing fluid flows between fractures},
  abstract_en  = {The invention relates to hydrocarbon production technologies, in particular to optimizing the parameters that directly affect well productivity in hydraulic fracturing. The technical result is obtaining the optimal fracturing parameters to increase hydrocarbon production and well flow rates in the field. According to the method, well and reservoir data are obtained, and data on the fracturing fluid, proppant, acids and the treatment are specified. These data are used to determine the motion of the fracturing fluid in the well: the total flow rate of the fluid with acid and proppant, and the proppant concentration and fluid temperature in the perforation zone. A fracture growth pattern is formed by iteratively varying the fluid, proppant, acid and/or treatment data, and the maximum fracture conductivity is determined. In doing so, the method determines the distribution of fluid flows with acid and of proppant among the fractures; the fracture opening and the pressure of the fluid with proppant and acid; the position and velocity of the fracture front; the fluid and proppant concentration in the fracture, the fluid temperature in the fracture and the thickness of rock that has reacted with acid; and the fields of additional confining stresses for each fracture. Fracturing is then performed with the optimal fluid, proppant, acid and treatment data obtained from the fracture growth pattern and corresponding to the maximum fracture conductivity. 3 independent and 7 dependent claims, 22 figures.},
  translation  = {auto}
}

@software{imomnazarov2025programma,
  author       = {Имомназаров, Б. Х. and Старовойтова, Б. Н. and Байкин, А. Н.},
  title        = {Программа для уточнения компонентного состава пластового газа по данным газоконденсатного исследования скважины с использованием оптимизационных алгоритмов},
  type         = {Свидетельство о государственной регистрации программы для ЭВМ},
  number       = {2025688995},
  date         = {2025-10-23},
  holder       = {Новосибирский национальный исследовательский государственный университет},
  holder_en    = {Novosibirsk State University},
  url          = {https://new.fips.ru/registers-doc-view/fips_servlet?DB=EVM&DocNumber=2025688995&TypeFile=html},
  langid       = {russian},
  keywords     = {gas-condensate, inverse-problems, software},
  abstract     = {Программа позволяет провести уточнение при отсутствии репрезентативных проб по фактическому газоконденсатному фактору, полученному в ходе газоконденсатного исследования скважины. Искомый компонентный состав определяется путем минимизации расхождения между фактическими и расчетными показателями, полученными с помощью гидродинамического моделирования газоконденсатного исследования. Программа использует встроенные в Python оптимизационные алгоритмы и сторонний модуль с библиотекой NOMAD. Для решения задачи моделирования встроен вызов консольной версии коммерческого симулятора tNavigator. Программа разработана в рамках реализации проекта FSUS-2025-0016. Тип ЭВМ: IBM PC-совмест. ПК. ОС: Windows 10/11.},
  title_en     = {Program for refining the component composition of reservoir gas from gas condensate well test data using optimization algorithms},
  abstract_en  = {In the absence of representative samples, the program refines the composition using the actual condensate–gas ratio measured in a gas condensate well test. The sought component composition is found by minimizing the mismatch between the actual values and the values computed by hydrodynamic simulation of the test. The program uses optimization algorithms built into Python and a third-party module with the NOMAD library, and calls the console version of the commercial simulator tNavigator to run the simulations. The program was developed within project FSUS-2025-0016. Computer: IBM PC-compatible. OS: Windows 10/11.},
  translation  = {auto}
}

@software{baykin2025programma,
  author       = {Байкин, А. Н. and Абдуллин, Р. Ф.},
  title        = {Программа для моделирования распространения тепла в термо-пороупругой среде при наличии трещин},
  type         = {Свидетельство о государственной регистрации программы для ЭВМ},
  number       = {2025611112},
  date         = {2025-01-16},
  holder       = {Новосибирский национальный исследовательский государственный университет},
  holder_en    = {Novosibirsk State University},
  url          = {https://new.fips.ru/registers-doc-view/fips_servlet?DB=EVM&DocNumber=2025611112&TypeFile=html},
  langid       = {russian},
  keywords     = {thermo-poroelasticity, fvm, software},
  abstract     = {Программа предназначена для проведения расчетов распространения тепла за счет конвекции жидкостью в порах и теплопроводности в пористой среде при наличии гидравлических трещин конечной проводимости. В трещинах перенос тепла осуществляется за счет конвекции. Отдельно рассчитывается напряженно-деформированное состояние с учетом изменения температуры и давления в пористой среде на основе решения уравнений термо-пороупругости. Задача решается в двумерной постановке. Дискретизация проводится методом конечных объемов. В качестве граничных условий задаются температура, давление или расход (на скважинах), векторы напряжений. Тип ЭВМ: IBM PC-совмест. ПК; ОС: Ubuntu.},
  title_en     = {Program for simulating heat transfer in a thermo-poroelastic medium with fractures},
  abstract_en  = {The program computes heat transfer by fluid convection in the pores and by conduction in a porous medium containing hydraulic fractures of finite conductivity; in the fractures heat is transferred by convection. The stress-strain state is computed separately, taking into account the changes of temperature and pressure in the porous medium, by solving the thermo-poroelasticity equations. The problem is two-dimensional and is discretized by the finite volume method. Boundary conditions specify temperature, pressure or flow rate (at wells) and traction vectors. Computer: IBM PC-compatible; OS: Ubuntu.},
  translation  = {auto}
}

@software{baykin2024programma,
  author       = {Байкин, А. Н.},
  title        = {Программа для моделирования криволинейного распространения трещины автоГРП в пороупругой среде},
  type         = {Свидетельство о государственной регистрации программы для ЭВМ},
  number       = {2024610653},
  date         = {2024-01-12},
  holder       = {Новосибирский национальный исследовательский государственный университет},
  holder_en    = {Novosibirsk State University},
  url          = {https://new.fips.ru/registers-doc-view/fips_servlet?DB=EVM&DocNumber=2024610653&TypeFile=html},
  langid       = {russian},
  keywords     = {auto-frac, poroelasticity, fracture-mechanics, freefem, software},
  abstract     = {Программа реализует математическую модель (из А. Н. Байкин. Моделирование криволинейного распространения трещины автоГРП в пороупругой среде // Цифровые технологии в добыче углеводородов: цифровая прозрачность. Сборник тезисов науч.-техн. конф., Уфа, РН-БашНИПИнефть, 2023) для описания криволинейного развития трещины самопроизвольного гидроразрыва пласта на нагнетательных скважинах (автоГРП) в двумерной пороупругой среде. Дискретизация проводится расширенным методом конечных элементов. Коэффициенты интенсивности считаются на основе эффективных напряжений. Для расчета поворота трещины используется критерий максимальных растягивающих напряжений. Реализован учет работы окружающих скважин. ОС: Ubuntu 22.04.},
  title_en     = {Program for simulating curvilinear propagation of a self-induced fracture in a poroelastic medium},
  abstract_en  = {The program implements the mathematical model (from A. N. Baykin, Modelling of curvilinear propagation of a self-induced fracture in a poroelastic medium, in: Digital Technologies in Hydrocarbon Production: Digital Transparency, Ufa, RN-BashNIPIneft, 2023) of curvilinear growth of a spontaneous (self-induced) hydraulic fracture at injection wells in a two-dimensional poroelastic medium. The problem is discretized by the extended finite element method. Stress intensity factors are computed from effective stresses. Fracture turning is determined by the maximum tensile stress criterion. The operation of surrounding wells is taken into account. OS: Ubuntu 22.04.},
  translation  = {auto}
}

@software{abdullin2022programmnyi,
  author       = {Абдуллин, Р. Ф. and Байкин, А. Н. and Валов, А. В. and Головин, С. В.},
  title        = {Программный комплекс для расчета геометрии плоской трещины ГРП по модели KGD ILSA и PKN ILSA с алгоритмом решения контактной задачи для закрытия трещины},
  type         = {Свидетельство о государственной регистрации программы для ЭВМ},
  number       = {2022619974},
  date         = {2022-05-27},
  holder       = {Новосибирский национальный исследовательский государственный университет},
  holder_en    = {Novosibirsk State University},
  url          = {https://new.fips.ru/registers-doc-view/fips_servlet?DB=EVM&DocNumber=2022619974&TypeFile=html},
  langid       = {russian},
  keywords     = {hydraulic-fracturing, level-set, software},
  abstract     = {Программный комплекс предназначен для моделирования распространения плоской трещины гидроразрыва пласта (ГРП) фиксированной высоты в упругой среде на основе подхода ILSA. Для утечек жидкости в пласт используется модель Картера. Реализован API для подключения внешних модулей расчета фильтрации жидкости и учета дополнительных сжимающих напряжений в пласте. Реализовано решение контактной задачи для закрытия трещины. В процессе выполнения программы рассчитываются геометрия трещины, распределение давления на стенках трещины, объем утечек жидкости в процессе фильтрации в окружающую породу. ОС: Windows 10, Linux (Ubuntu 20.04), MacOS > 11.0.},
  title_en     = {Software suite for computing planar hydraulic fracture geometry with the KGD ILSA and PKN ILSA models and a contact algorithm for fracture closure},
  abstract_en  = {The software suite simulates the propagation of a planar fixed-height hydraulic fracture in an elastic medium using the ILSA approach. Fluid leak-off into the formation is described by the Carter model. An API is provided for plugging in external modules that compute fluid filtration and additional confining stresses in the formation. The contact problem for fracture closure is solved. During a run, the program computes the fracture geometry, the pressure distribution on the fracture walls and the volume of fluid leaking off into the surrounding rock. OS: Windows 10, Linux (Ubuntu 20.04), macOS > 11.0.},
  translation  = {auto}
}

@software{baykin2022programma,
  author       = {Байкин, А. Н. and Головин, С. В.},
  title        = {Программа для моделирования развития плоской трещины ГРП в трехмерной пороупругой среде и анализа мини-ГРП},
  type         = {Свидетельство о государственной регистрации программы для ЭВМ},
  number       = {2022660749},
  date         = {2022-06-08},
  holder       = {Новосибирский национальный исследовательский государственный университет},
  holder_en    = {Novosibirsk State University},
  url          = {https://new.fips.ru/registers-doc-view/fips_servlet?DB=EVM&DocNumber=2022660749&TypeFile=html},
  langid       = {russian},
  keywords     = {planar3d, mini-frac, poroelasticity, freefem, software},
  abstract     = {Программа реализует математическую модель из https://doi.org/10.1007/s00603-021-02523-x для описания распространения плоской трещины гидроразрыва пласта (ГРП) в трехмерной слоистой пороупругой среде с учетом неньютоновости жидкости, влияния ствола скважины и наличия конечной перфорации. Дискретизация производится методом конечных элементов. Реализован расчет производных решения по заданному параметру методом прямого дифференцирования. Также реализовано решение обратной задачи нахождения неизвестных проницаемости и сжимающих напряжений путем подбора параметров модели для обеспечения совпадения экспериментальной и численной кривых давления. ОС: Linux OS (Ubuntu 20.04).},
  title_en     = {Program for simulating planar hydraulic fracture growth in a three-dimensional poroelastic medium and for mini-frac analysis},
  abstract_en  = {The program implements the mathematical model from https://doi.org/10.1007/s00603-021-02523-x describing the propagation of a planar hydraulic fracture in a three-dimensional layered poroelastic medium, taking into account non-Newtonian fluid behavior, the influence of the wellbore and a finite perforation interval. The problem is discretized by the finite element method. Derivatives of the solution with respect to a given parameter are computed by direct differentiation. The inverse problem of finding unknown permeability and confining stresses is also solved by fitting the model parameters until the measured and computed pressure curves match. OS: Linux (Ubuntu 20.04).},
  translation  = {auto}
}

@software{golovin2022programma,
  author       = {Головин, С. В. and Байкин, А. Н. and Абдуллин, Р. Ф.},
  title        = {Программа для моделирования развития плоской трещины ГРП (авто-ГРП) в пороупругой среде},
  type         = {Свидетельство о государственной регистрации программы для ЭВМ},
  number       = {2022660750},
  date         = {2022-06-08},
  holder       = {Новосибирский национальный исследовательский государственный университет},
  holder_en    = {Novosibirsk State University},
  url          = {https://new.fips.ru/registers-doc-view/fips_servlet?DB=EVM&DocNumber=2022660750&TypeFile=html},
  langid       = {russian},
  keywords     = {auto-frac, poroelasticity, freefem, software},
  abstract     = {Программа предназначена для моделирования распространения плоской трещины гидроразрыва пласта (ГРП) и авто-ГРП фиксированной высоты из нагнетательной скважины в пороупругой среде в приближении плоской деформации и плоских напряжений на выбор. Для расчета влияния порового давления на НДС и фильтрации закачиваемой жидкости в пласт решается система уравнений Био методом конечных элементов, которая связана итеративно с течением жидкости в трещине и ее раскрытием, рассчитываемым методом разрывных смещений. В качестве входных данных задаются параметры среды и закачиваемой жидкости, начальное распределение порового давления, расположение скважин, расписание закачки. ОС: Windows 10, Linux OS (Ubuntu 20.04).},
  title_en     = {Program for simulating the growth of a planar hydraulic fracture (self-induced fracture) in a poroelastic medium},
  abstract_en  = {The program simulates the propagation of a fixed-height planar hydraulic fracture or self-induced fracture from an injection well in a poroelastic medium in the plane-strain or plane-stress approximation (selectable). To account for the effect of pore pressure on the stress-strain state and for the filtration of the injected fluid into the formation, the Biot equations are solved by the finite element method; they are coupled iteratively with the fluid flow in the fracture and its opening, computed by the displacement discontinuity method. The input includes the properties of the medium and the injected fluid, the initial pore pressure distribution, the well locations and the pumping schedule. OS: Windows 10, Linux (Ubuntu 20.04).},
  translation  = {auto}
}

@software{golovin2020modulb,
  author       = {Головин, С. В. and Валов, А. В. and Байкин, А. Н. and Донцов, Е. В. and Гурин, А. М. and Ковтуненко, П. В. and Скопинцев, А. М. and Падерин, Г. В. and Шель, Е. В.},
  title        = {Модуль расчета многостадийного ГРП в слоистой по сжимающим напряжениям среде в рамках модели Planar 3D ILSA},
  type         = {Свидетельство о государственной регистрации программы для ЭВМ},
  number       = {2020611805},
  date         = {2020-02-11},
  holder       = {ООО «Газпромнефть НТЦ»},
  holder_en    = {Gazpromneft STC LLC},
  url          = {https://new.fips.ru/registers-doc-view/fips_servlet?DB=EVM&DocNumber=2020611805&TypeFile=html},
  langid       = {russian},
  keywords     = {planar3d, level-set, software},
  abstract     = {Программа предназначена для расчета геометрии плоских трещин при многостадийном ГРП (гидроразрыве пласта) в слоистой по сжимающим напряжениям упругой однородной среде. Технология ГРП широко применяется в нефтегазовой индустрии для интенсификации притока углеводородов. Программа позволяет проектировать параметры получаемых трещин гидроразрыва в пласте, их размеры (длину, ширину, высоту), проводимость, а также давление жидкости гидроразрыва на устье и в трещинах в ходе проведения операции ГРП. Отличительной особенностью является учёт взаимовлияния трещин друг на друга при одновременном росте на скважине. На входе в программу задаются физические параметры породы и закачиваемой жидкости, задаётся дизайн ГРП, включающий в себя расписания закачки по стадиям, и позиции портов. Выходными данными является серия геометрий единичных трещин, раскрытие и давление внутри каждой из них. Тип ЭВМ: IBM PC с одноядерным или многоядерным процессором; ОС: Windows 7 / 10.},
  title_en     = {Module for multistage hydraulic fracturing in a medium layered by confining stress within the Planar 3D ILSA model},
  abstract_en  = {The program computes the geometry of planar fractures in multistage hydraulic fracturing in a homogeneous elastic medium layered by confining stress. Hydraulic fracturing is widely used in the oil and gas industry to stimulate hydrocarbon inflow. The program makes it possible to design the parameters of the created fractures — their length, width and height, conductivity — and the fracturing fluid pressure at the wellhead and in the fractures during the treatment. Its distinctive feature is accounting for the mutual influence of fractures growing simultaneously from the well. The input is the physical properties of the rock and the injected fluid and the treatment design, including the stage pumping schedules and port positions. The output is a series of single-fracture geometries with the opening and pressure in each fracture. Computer: IBM PC with a single- or multi-core processor; OS: Windows 7/10.},
  translation  = {auto}
}

@software{golovin2020modul,
  author       = {Головин, С. В. and Валов, А. В. and Байкин, А. Н. and Донцов, Е. В. and Гурин, А. М. and Ковтуненко, П. В. and Скопинцев, А. М. and Падерин, Г. В. and Шель, Е. В.},
  title        = {Модуль расчета геометрии плоской трещины ГРП в слоистой по сжимающим напряжениям среде по модели Planar 3D ILSA},
  type         = {Свидетельство о государственной регистрации программы для ЭВМ},
  number       = {2020611608},
  date         = {2020-02-05},
  holder       = {ООО «Газпромнефть НТЦ»},
  holder_en    = {Gazpromneft STC LLC},
  url          = {https://new.fips.ru/registers-doc-view/fips_servlet?DB=EVM&DocNumber=2020611608&TypeFile=html},
  langid       = {russian},
  keywords     = {planar3d, level-set, software},
  abstract     = {Программа предназначена для расчета геометрии одиночной плоской трещины ГРП (гидроразрыва пласта) в слоистой по сжимающим напряжениям упругой однородной среде. Позволяет проектировать параметры получаемых трещин гидроразрыва в пласте, их размеры (длину, ширину, высоту), проводимость, а также давление жидкости гидроразрыва на устье и в трещинах в ходе проведения операции ГРП. Раскрытие вблизи фронта трещины описывается универсальной асимптотикой. Позиция фронта трещины описывается изотропным уравнением эйконала, решаемого при помощи монотонного метода FMM. Для решения СЛАУ используется алгоритм partial-LU из пакета Eigen. На входе задаются физические параметры породы и закачиваемой жидкости. Выходными данными является геометрия трещины, раскрытие и давление внутри неё. Тип ЭВМ: IBM PC-совмест. ПК. ОС: Windows 7/10.},
  title_en     = {Module for computing planar hydraulic fracture geometry in a medium layered by confining stress with the Planar 3D ILSA model},
  abstract_en  = {The program computes the geometry of a single planar hydraulic fracture in a homogeneous elastic medium layered by confining stress. It makes it possible to design the parameters of the created fractures — their length, width and height, conductivity — and the fracturing fluid pressure at the wellhead and in the fractures during the treatment. The opening near the fracture front is described by a universal asymptote. The front position is described by the isotropic eikonal equation solved with the monotone FMM method. Linear systems are solved with the partial-LU algorithm from the Eigen library. The input is the physical properties of the rock and the injected fluid. The output is the fracture geometry, its opening and the pressure inside it. Computer: IBM PC-compatible. OS: Windows 7/10.},
  translation  = {auto}
}

@software{neverov2020modul,
  author       = {Неверов, В. В. and Байкин, А. Н. and Падерин, Г. В. and Кабанова, П. К. and Шель, Е. В.},
  title        = {Модуль динамики многокомпонентной жидкости в скважине в рамках односкоростного подхода},
  type         = {Свидетельство о государственной регистрации программы для ЭВМ},
  number       = {2020615223},
  date         = {2020-05-19},
  holder       = {ООО «Газпромнефть НТЦ»},
  holder_en    = {Gazpromneft STC LLC},
  url          = {https://new.fips.ru/registers-doc-view/fips_servlet?DB=EVM&DocNumber=2020615223&TypeFile=html},
  langid       = {russian},
  keywords     = {wellbore-flow, multiphase-flow, proppant-transport, software},
  abstract     = {Программа предназначена для расчета течения смеси жидкости и проппанта в цилиндрической скважине переменного диаметра с произвольной инклинометрией. Модуль используется в составе комплексного программного продукта для проектирования дизайна операции гидроразрыва пласта. Закачиваемая смесь жидкости и проппанта имеет степенную реологию, скорости жидкости и проппанта равны. Учет влияния проппанта на вязкость смеси рассчитывается по экспериментальным корреляциям. Расчет гидравлического сопротивления проводится либо по корреляциям для течения степенной жидкости в трубе, либо по таблицам сопротивления. На входе задается конструкция скважины и расписание закачки. Выходными данными являются гидростатическое давление, гидравлическое сопротивление и концентрация проппанта. Тип ЭВМ: IBM PC-совмест. ПК. ОС: Windows 7/10.},
  title_en     = {Module for multicomponent fluid dynamics in a wellbore within the single-velocity approach},
  abstract_en  = {The program computes the flow of a fluid–proppant mixture in a cylindrical wellbore of variable diameter with arbitrary inclination. The module is part of a comprehensive software product for hydraulic fracturing treatment design. The injected fluid–proppant mixture has power-law rheology, and the fluid and proppant velocities are equal. The effect of proppant on the mixture viscosity is calculated from experimental correlations. Hydraulic friction is calculated either from correlations for power-law fluid flow in a pipe or from friction tables. The input is the well design and the pumping schedule. The output is the hydrostatic pressure, the hydraulic friction and the proppant concentration. Computer: IBM PC-compatible. OS: Windows 7/10.},
  translation  = {auto}
}

@software{neverov2020modulb,
  author       = {Неверов, В. В. and Байкин, А. Н. and Шелухин, В. В. and Головин, С. В.},
  title        = {Модуль неизотермического многофазного течения в стволе скважины произвольной конструкции},
  type         = {Свидетельство о государственной регистрации программы для ЭВМ},
  number       = {2020610879},
  date         = {2020-01-21},
  holder       = {Московский физико-технический институт (национальный исследовательский университет)},
  holder_en    = {Moscow Institute of Physics and Technology},
  url          = {https://new.fips.ru/registers-doc-view/fips_servlet?DB=EVM&DocNumber=2020610879&TypeFile=html},
  langid       = {russian},
  keywords     = {wellbore-flow, multiphase-flow, software},
  abstract     = {Программа предназначена для расчета гидравлического сопротивления при течении смеси жидкости и проппанта в цилиндрической скважине переменного диаметра с произвольной инклинометрией. Закачиваемая жидкость имеет степенную реологию. Расчет сопротивления проводится по корреляциям для течения степенной жидкости в трубе, либо по таблицам сопротивления. На входе задается конструкция скважины, температура пласта и расписание закачки. Выходными данными является гидростатическое давление, гидравлическое сопротивление и температура смеси. Модуль расчета скомпилирован в динамическую библиотеку. Возможна запись результатов в файл формата hdf5. Модуль является подключаемым элементом программного комплекса «Кибер ГРП». Тип ЭВМ: IBM PC-совмест. ПК.},
  title_en     = {Module for non-isothermal multiphase flow in a wellbore of arbitrary design},
  abstract_en  = {The program computes the hydraulic friction of a fluid–proppant mixture flowing in a cylindrical wellbore of variable diameter with arbitrary inclination. The injected fluid has power-law rheology. Friction is calculated from correlations for power-law fluid flow in a pipe or from friction tables. The input is the well design, the reservoir temperature and the pumping schedule. The output is the hydrostatic pressure, the hydraulic friction and the mixture temperature. The module is compiled into a dynamic library; results can be written to an HDF5 file. The module is a plug-in of the CyberFrac (Кибер ГРП) software suite. Computer: IBM PC-compatible.},
  translation  = {auto}
}

@software{baykin2020modul,
  author       = {Байкин, А. Н.},
  title        = {Модуль расчета геометрии трещин при многостадийном ГРП в рамках модели Planar 3D Biot с учетом эффектов пороупругости и взаимодействия трещин},
  type         = {Свидетельство о государственной регистрации программы для ЭВМ},
  number       = {2020610083},
  date         = {2020-01-09},
  holder       = {Московский физико-технический институт (национальный исследовательский университет)},
  holder_en    = {Moscow Institute of Physics and Technology},
  url          = {https://new.fips.ru/registers-doc-view/fips_servlet?DB=EVM&DocNumber=2020610083&TypeFile=html},
  langid       = {russian},
  keywords     = {planar3d, poroelasticity, software},
  abstract     = {Программа предназначена для моделирования распространения трещин ГРП в пороупругой среде по заданным параметрам пласта и сценарию закачки. Механика горной породы рассчитывается по модели Био. В качестве входных параметров задаётся геометрия области, параметры сетки, свойства породы, параметры жидкости, расписание закачки, набор настроечных параметров. Выходными данными является геометрия трещины в заданный момент времени, поле перемещений в горной породе, распределение давления в трещине и пласте. Модуль является подключаемым элементом программного комплекса «Кибер ГРП». Тип ЭВМ: IBM PC-совмест. ПК.},
  title_en     = {Module for computing fracture geometry in multistage hydraulic fracturing with the Planar 3D Biot model accounting for poroelastic effects and fracture interaction},
  abstract_en  = {The program simulates hydraulic fracture propagation in a poroelastic medium for given reservoir parameters and pumping scenario. Rock mechanics is described by the Biot model. The input includes the domain geometry, mesh parameters, rock and fluid properties, the pumping schedule and a set of tuning parameters. The output is the fracture geometry at a given time, the displacement field in the rock and the pressure distribution in the fracture and the reservoir. The module is a plug-in of the CyberFrac (Кибер ГРП) software suite. Computer: IBM PC-compatible.},
  translation  = {auto}
}

@software{gurin2019vychislitelnyi,
  author       = {Гурин, А. М. and Полянский, Т. А. and Байкин, А. Н.},
  title        = {Вычислительный пакет FEMEngine на основе метода конечных элементов с линейными конечными элементами на треугольной сетке},
  type         = {Свидетельство о государственной регистрации программы для ЭВМ},
  number       = {2019664165},
  date         = {2019-10-31},
  holder       = {Институт гидродинамики им. М. А. Лаврентьева СО РАН},
  holder_en    = {Lavrentyev Institute of Hydrodynamics SB RAS},
  url          = {https://new.fips.ru/registers-doc-view/fips_servlet?DB=EVM&DocNumber=2019664165&TypeFile=html},
  langid       = {russian},
  keywords     = {fem, software},
  abstract     = {Программа предназначена для численного решения широкого круга задач механики сплошных сред методом конечных элементов и реализована в виде подключаемой библиотеки из заголовочных файлов. Вариационная форма задачи записывается на языке С++ в форме, близкой к естественной математической записи, благодаря используемой функциональной парадигме программирования. Реализованный инструментарий позволяет записывать уравнения на 3D, 2D и 1D элементах в 3D задачах. Существует возможность создавать дополнительные степени свободы на поверхностях и ребрах геометрии в 3D задаче. Механизм шаблонов С++ используется для создания высокоэффективного конструктора матрицы, полученной из заданной на стадии компиляции вариационной формулировки задачи. Программа поддерживает импорт расчетной сетки в формате Gmsh, а также построение сетки с помощью Netgen из геометрии, заданной в формате brep. Для решения полученной системы линейных уравнений используется прямой решатель. Библиотека предоставляет API через С++ заголовочные файлы. Сборка модуля производится системой сборки CMake с генерацией config-файла для упрощения подключения модуля к программам пользователей. Результаты расчетов могут быть сохранены в формате XDMF для визуализации в ParaView.},
  title_en     = {FEMEngine: a finite element computational package with linear elements on triangular meshes},
  abstract_en  = {The program solves a wide range of continuum mechanics problems by the finite element method and is implemented as a header-only library. Thanks to the functional programming paradigm, the variational form of a problem is written in C++ in a form close to natural mathematical notation. The toolkit allows equations to be written on 3D, 2D and 1D elements in 3D problems, and additional degrees of freedom can be created on surfaces and edges of the geometry in a 3D problem. C++ templates are used to build a highly efficient matrix assembler from the variational formulation given at compile time. The program supports importing meshes in the Gmsh format and meshing with Netgen from geometry in the BREP format. The resulting linear system is solved by a direct solver. The library provides its API through C++ header files. The module is built with CMake, which generates a config file to simplify linking the module to user programs. Results can be saved in the XDMF format for visualization in ParaView.},
  translation  = {auto}
}

@software{golovin2019prototip,
  author       = {Головин, С. В. and Байкин, А. Н.},
  title        = {Прототип программного модуля для модели Planar 3D Biot Lagrange раскрытия плоской трещины ГРП с алгоритмом решения контактной задачи на основе множителей Лагранжа},
  type         = {Свидетельство о государственной регистрации программы для ЭВМ},
  number       = {2019613272},
  date         = {2019-03-13},
  holder       = {Московский физико-технический институт (государственный университет)},
  holder_en    = {Moscow Institute of Physics and Technology},
  url          = {https://new.fips.ru/registers-doc-view/fips_servlet?DB=EVM&DocNumber=2019613272&TypeFile=html},
  langid       = {russian},
  keywords     = {planar3d, poroelasticity, freefem, software},
  abstract     = {Программа предназначена для моделирования распространения одиночной плоской трещины ГРП в пороупругой среде по заданным параметрам пласта и сценарию закачки. В качестве математической модели используется модель Planar 3D Biot, решение контактной задачи реализовано на основе множителей Лагранжа. Для численной дискретизации функций используются кусочно-линейные элементы на тетраэдрах. Для решения СЛАУ используется решатель MUMPS. Построение сетки осуществляется встроенными средствами FreeFem++. В качестве входных параметров задаются геометрия расчетной области, физические параметры породы и закачиваемой жидкости. Выходными данными являются поле перемещений в породе и распределение давления.},
  title_en     = {Prototype software module for the Planar 3D Biot Lagrange model of planar hydraulic fracture opening with a Lagrange-multiplier contact algorithm},
  abstract_en  = {The program simulates the propagation of a single planar hydraulic fracture in a poroelastic medium for given reservoir parameters and pumping scenario. The mathematical model is Planar 3D Biot; the contact problem is solved with Lagrange multipliers. Functions are discretized with piecewise linear elements on tetrahedra. Linear systems are solved with MUMPS. Meshes are built with the built-in tools of FreeFem++. The input is the geometry of the computational domain and the physical properties of the rock and the injected fluid. The output is the displacement field in the rock and the pressure distribution.},
  translation  = {auto}
}

