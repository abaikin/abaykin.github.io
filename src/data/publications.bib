@article{baykin2015capacity,
  author       = {Baykin, A. N. and Vodop’yanov, S. K.},
  title        = {Capacity estimates, Liouville’s theorem, and singularity removal for mappings with bounded $(p,q)$-distortion},
  journal      = {Siberian Mathematical Journal},
  year         = {2015},
  volume       = {56},
  number       = {2},
  pages        = {237--261},
  doi          = {10.1134/S0037446615020056},
  issn         = {0037-4466},
  langid       = {english},
  indexing     = {wos, scopus},
  abstract     = {The mappings with bounded weighted $(p,q)$-distortion are natural generalizations of the class of mappings with bounded distortion which appears as a doubly indexed scale for $p = q = n$ in the absence of weight functions. In case $n - 1 < q \le p = n$, the mappings with bounded $(p,q)$-distortion were studied previously in a series of articles under the additional assumption that the mapping enjoys Luzin’s $N$-property. In this article we present the first facts of the theory of mappings with bounded $(p,q)$-distortion which are obtained without additional analytical assumptions. The core of the theory consists of the new analytical properties of pushforward functions; in particular, we prove that the gradient of the pushforward function vanishes almost everywhere on the image of the branch set. Some estimates are given on the capacity of the images of condensers under mappings with bounded $(p,q)$-distortion. We obtain Liouville-type theorems and the singularity removal theorems for the mappings of this class, and we apply these theorems to classifying manifolds.},
  title_ru     = {Оценки ёмкости, теорема Лиувилля и устранение особенностей для отображений с ограниченным $(p,q)$-искажением},
  abstract_ru  = {Отображения с ограниченным весовым $(p,q)$-искажением — естественное обобщение класса отображений с ограниченным искажением, который в отсутствие весовых функций соответствует случаю $p = q = n$ этой двухиндексной шкалы. При $n - 1 < q \le p = n$ отображения с ограниченным $(p,q)$-искажением ранее изучались в серии работ при дополнительном предположении, что отображение обладает $N$-свойством Лузина. В статье изложены первые факты теории отображений с ограниченным $(p,q)$-искажением, полученные без дополнительных аналитических предположений. Основу теории составляют новые аналитические свойства функций-образов (pushforward); в частности, доказано, что градиент такой функции почти всюду обращается в нуль на образе множества ветвления. Получены оценки ёмкости образов конденсаторов при отображениях с ограниченным $(p,q)$-искажением. Доказаны теоремы типа Лиувилля и теоремы об устранении особенностей для отображений этого класса; эти теоремы применены к классификации многообразий.},
  translation  = {auto}
}

@article{baikin2013stationary,
  author       = {Baikin, A. N. and Golovin, S. V.},
  title        = {Stationary cylindrical vortex in a viscous electrically conducting fluid},
  journal      = {Journal of Applied Mechanics and Technical Physics},
  year         = {2013},
  volume       = {54},
  number       = {4},
  pages        = {541--551},
  doi          = {10.1134/S0021894413040044},
  issn         = {0021-8944},
  langid       = {english},
  indexing     = {wos, scopus},
  abstract     = {An exact solution of the magnetohydrodynamic equations is constructed which describes steady vortex flow in a stationary cylinder on the axis of which a conductor carrying a known current is located. The solution is obtained under the assumption that the fluid is viscous and has finite electrical conductivity and that the magnetic field has only the axial and azimuthal components in a cylindrical coordinate system. It is found that the action of the Lorentz force is compensated by changing the pressure. Fluid flow occurs from the periphery to the axis of the cylinder under a pressure gradient, with flow rotation and swirling. The fluid flow causes a concentration of the magnetic lines near the axis of the cylinder, providing an exponential decrease in the magnetic field strength with distance from the axis. This flow can be considered as a model of a local increase in the magnetic field strength due to the transfer of its force lines by the flow of the electrically conducting fluid.},
  title_ru     = {Стационарный цилиндрический вихрь в вязкой электропроводной жидкости},
  abstract_ru  = {Построено точное решение уравнений магнитной гидродинамики, описывающее стационарное вихревое течение в неподвижном цилиндре, на оси которого расположен проводник с заданным током. Решение получено в предположении, что жидкость вязкая и имеет конечную электропроводность, а магнитное поле имеет только осевую и азимутальную компоненты в цилиндрической системе координат. Установлено, что действие силы Лоренца компенсируется изменением давления. Под действием градиента давления жидкость течёт от периферии к оси цилиндра, вращаясь и закручиваясь. Течение приводит к концентрации магнитных силовых линий у оси цилиндра, так что напряжённость магнитного поля экспоненциально убывает с удалением от оси. Такое течение можно рассматривать как модель локального усиления магнитного поля за счёт переноса его силовых линий потоком электропроводной жидкости.},
  translation  = {auto}
}

