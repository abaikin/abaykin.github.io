@article{golovin2018influence,
  author       = {Golovin, S. V. and Baykin, A. N.},
  title        = {Influence of pore pressure on the development of a hydraulic fracture in poroelastic medium},
  journal      = {International Journal of Rock Mechanics and Mining Sciences},
  year         = {2018},
  volume       = {108},
  pages        = {198--208},
  doi          = {10.1016/j.ijrmms.2018.04.055},
  issn         = {1365-1609},
  langid       = {english},
  eprint       = {1608.08001},
  eprinttype   = {arxiv},
  keywords     = {poroelasticity, hydraulic-fracturing, fem},
  indexing     = {wos, scopus, rinc},
  elibrary     = {35750698},
  abstract     = {In this paper we demonstrate the influence of the pore pressure to the development of a hydraulically-driven fracture in a poroelastic medium. We present a novel numerical model for propagation of a planar hydraulic fracture and prove its correctness by demonstration of the numerical convergence and by comparison with known solutions. The advantage of the algorithm is that it does not require the distinguishing of the fracture's tips and reconstruction of the numerical mesh according to the fracture propagation. Next, we perform a thorough analysis of the interplay of fluid filtration and redistribution of stresses near the fracture. We demonstrate that the fracture length decreases with the increase of the Biot's number (the parameter that determines the contribution of the pore pressure to the stress) and explain this effect by analysing the near-fracture pore pressure, rock deformation and stresses. We conclude, that the correct account for the fluid exchange between the fracture and the rock should be based not only on physical parameters of the rock and fluid, but also on the analysis of stresses near the fracture.},
  title_ru     = {Влияние порового давления на развитие трещины гидроразрыва в пороупругой среде},
  abstract_ru  = {В статье показано влияние порового давления на развитие трещины гидроразрыва в пороупругой среде. Представлена новая численная модель распространения плоской трещины гидроразрыва; её корректность подтверждена численной сходимостью и сравнением с известными решениями. Преимущество алгоритма в том, что он не требует выделять вершины трещины и перестраивать расчётную сетку по мере её роста. Подробно проанализировано взаимодействие фильтрации жидкости и перераспределения напряжений вблизи трещины. Показано, что длина трещины уменьшается с ростом числа Био (параметра, определяющего вклад порового давления в напряжения), и этот эффект объяснён анализом порового давления, деформации породы и напряжений вблизи трещины. Сделан вывод, что корректный учёт обмена жидкостью между трещиной и породой должен опираться не только на физические параметры породы и жидкости, но и на анализ напряжений вблизи трещины.},
  translation  = {auto}
}

@article{baykin2017analysis,
  author       = {Baykin, A. N. and Golovin, S. V.},
  title        = {Analysis of the in situ stress contrast impact on a planar hydraulic fracture propagation using the fully coupled poroelastic model},
  journal      = {Journal of Physics: Conference Series},
  year         = {2017},
  volume       = {894},
  eid          = {012005},
  doi          = {10.1088/1742-6596/894/1/012005},
  issn         = {1742-6588},
  langid       = {english},
  keywords     = {planar3d, poroelasticity, hydraulic-fracturing},
  indexing     = {wos, scopus},
  abstract     = {In this paper, we use a fully coupled model for 3D planar fracture propagation within a poroelastic reservoir in order to analysis the non-symmetry of the fracture as it develops in a 3-layer reservoir with different compressive stresses in each layer. We demonstrate that the fracture predominantly develops in the layer with the lower compressive stress until it gets arrested due to the equality of the total leakoff to the volume of pumped fluid.},
  title_ru     = {Анализ влияния контраста напряжений in situ на распространение плоской трещины гидроразрыва с помощью полностью связанной пороупругой модели},
  abstract_ru  = {С помощью полностью связанной модели распространения плоской трещины в трёхмерном пороупругом пласте анализируется несимметричность трещины, развивающейся в трёхслойном пласте с разными сжимающими напряжениями в слоях. Показано, что трещина растёт преимущественно в слое с меньшим сжимающим напряжением, пока не остановится, когда суммарные утечки сравняются с объёмом закачанной жидкости.},
  translation  = {auto}
}

@article{baykin2016modelling,
  author       = {Baykin, A. N. and Golovin, S. V.},
  title        = {Modelling of hydraulic fracture propagation in inhomogeneous poroelastic medium},
  journal      = {Journal of Physics: Conference Series},
  year         = {2016},
  volume       = {722},
  eid          = {012003},
  doi          = {10.1088/1742-6596/722/1/012003},
  issn         = {1742-6588},
  langid       = {english},
  keywords     = {poroelasticity, hydraulic-fracturing, fracture-mechanics},
  indexing     = {wos, scopus},
  abstract     = {In the paper a model for description of a hydraulic fracture propagation in inhomogeneous poroelastic medium is proposed. Among advantages of the presented numerical algorithm, there are incorporation of the near-tip analysis into the general computational scheme, account for the rock failure criterion on the base of the cohesive zone model, possibility for analysis of fracture propagation in inhomogeneous reservoirs. The numerical convergence of the algorithm is verified and the agreement of our numerical results with known solutions is established. The influence of the inhomogeneity of the reservoir permeability to the fracture time evolution is also demonstrated.},
  title_ru     = {Моделирование распространения трещины гидроразрыва в неоднородной пороупругой среде},
  abstract_ru  = {Предложена модель распространения трещины гидроразрыва в неоднородной пороупругой среде. Среди достоинств численного алгоритма — включение асимптотического анализа у вершины трещины в общую вычислительную схему, учёт критерия разрушения породы на основе модели когезионной зоны и возможность анализировать распространение трещины в неоднородных пластах. Проверена численная сходимость алгоритма и установлено согласие численных результатов с известными решениями. Показано также влияние неоднородности проницаемости пласта на развитие трещины во времени.},
  translation  = {auto}
}

