  author       = {Астафьев, В. Н. and Мажирин, Ю. А. and Абдуллин, Р. Ф. and Аввакумов, А. А. and Андреев, Д. О. and Байкин, А. Н. and Белов, Я. А. and Бесов, А. С. and Бойко, О. А. and Бурков, М. П. and Валиуллина, Г. К. and Головин, С. В. and Горносталев, Д. И. and Дмитрачков, Д. К. and Зотов, А. М. and Калинин, С. А. and Каримов, А. Ф. and Копейкин, Р. Р. and Неверов, В. В. and Непоп, Р. К. and Низаметдинова, М. А. and Сибин, А. Н. and Смирнов, Н. Ю. and Фархутдинов, Р. Р. and Фомин, К. А. and Чеботников, А. В. and Шель, Е. В.},
  author_en    = {Astafyev, V. N. and Mazhirin, Yu. A. and Abdullin, R. F. and Avvakumov, A. A. and Andreev, D. O. and Baykin, A. N. and Belov, Ya. A. and Besov, A. S. and Boiko, O. A. and Burkov, M. P. and Valiullina, G. K. and Golovin, S. V. and Gornostalev, D. I. and Dmitrachkov, D. K. and Zotov, A. M. and Kalinin, S. A. and Karimov, A. F. and Kopeykin, R. R. and Neverov, V. V. and Nepop, R. K. and Nizametdinova, M. A. and Sibin, A. N. and Smirnov, N. Yu. and Farkhutdinov, R. R. and Fomin, K. A. and Chebotnikov, A. V. and Shel, E. V.},
  title        = {Развитие технологий гидроразрыва пласта в современных условиях (по материалам II Технологического форума «Технологии ГРП»; 20.11.2023–21.11.2023, г. Новосибирск)},
  title_en     = {Development of hydraulic fracturing technologies in modern conditions (based on the materials of the 2nd Technological Forum “Hydraulic Fracturing Technologies”; 20.11.2023–21.11.2023, Novosibirsk)},
  journal      = {Геология и минерально-сырьевые ресурсы Сибири},
  journal_en   = {Geology and Mineral Resources of Siberia},
  year         = {2024},
  number       = {2 (58)},
  pages        = {100--109},
  doi          = {10.20403/2078-0575-2024-2-100-109},
  issn         = {2078-0575},
  langid       = {russian},
  keywords     = {hydraulic-fracturing},
  indexing     = {scopus, rinc},
  elibrary     = {67885262},
  abstract     = {Гидравлический разрыв пласта – основной метод стимуляции скважин для повышения эффективности разработки месторождений углеводородов. Семинар по технологиям и материалам ГРП, который уже много лет проводится на базе АО «Геологика» в Новосибирске, ежегодно привлекает внимание все большего числа ведущих отечественных специалистов и исследователей в области гидроразрыва; сейчас он преобразован в технологический форум, где обсуждается широкий круг вопросов в индустрии ГРП – от общего состояния отрасли в условиях санкционного давления до особенностей применения новых материалов, технологий и современных моделей гидроразрыва.},
  abstract_en  = {Currently, hydraulic fracturing is the main method of stimulating wells to increase the efficiency of hydrocarbon field development. Multiyear seminar on the hydraulic fracturing technologies and materials, held on the basis of JSC Geologika in Novosibirsk, annually attracting the attention of an increasing number of leading domestic specialists and researchers in the field of hydraulic fracturing, has been transformed into a technological forum where a wide range of issues in the hydraulic fracturing industry is discussed, from the general state of the industry under sanctions pressure to the specifics of the application of new materials, technologies and modern models of hydraulic fracturing.}
}

