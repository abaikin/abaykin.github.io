@inproceedings{gurin2019femengine,
  author       = {Gurin, A. M. and Baykin, A. N. and Polyansky, T. A. and Krivtsov, A. M.},
  title        = {FEMEngine: Finite Element Method C++ Code Based on Functional and Template Metaprogramming},
  booktitle    = {2019 Ivannikov ISPRAS Open Conference (ISPRAS)},
  publisher    = {IEEE},
  address      = {Moscow, Russia},
  year         = {2019},
  pages        = {92--96},
  doi          = {10.1109/ISPRAS47671.2019.00020},
  langid       = {english},
  pubtype      = {proceedings},
  keywords     = {fem, software},
  indexing     = {wos},
  abstract     = {The paper discusses the problems of a finite element method programming. Modern C++ functional programming and template metaprogramming approach to finite element analysis is presented. This approach simplifies the implementation of an effective assembly of the stiffness matrix for a problem defined by a weak form. This method is tested by a solution of the Poisson equation on an unstructured 3D tetrahedral mesh using FEM C++ library FEMEngine developed by authors. The function which calculates the matrix is generated by higher order functions during the compilation stage. The performance of the computation is analyzed by studying of a disassembled code and by comparison with the popular open source FEM software.},
  title_ru     = {FEMEngine: код метода конечных элементов на C++ на основе функционального и шаблонного метапрограммирования},
  abstract_ru  = {В статье обсуждаются проблемы программирования метода конечных элементов. Представлен подход к конечно-элементному анализу на основе современного функционального программирования и шаблонного метапрограммирования на C++. Он упрощает реализацию эффективной сборки матрицы жёсткости для задачи, заданной в слабой форме. Метод проверен на решении уравнения Пуассона на неструктурированной трёхмерной тетраэдральной сетке с помощью разработанной авторами конечно-элементной библиотеки FEMEngine на C++. Функция, вычисляющая матрицу, порождается функциями высших порядков на этапе компиляции. Производительность расчёта проанализирована по дизассемблированному коду и в сравнении с популярным открытым конечно-элементным ПО.},
