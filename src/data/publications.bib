@article{shukalo2026acceleration,
  author       = {Shukalo, V. I. and Valov, A. V. and Baykin, A. N.},
  title        = {Acceleration methods for the planar 3D ILSA hydraulic fracturing model},
  journal      = {Geomechanics for Energy and the Environment},
  year         = {2026},
  volume       = {48},
  eid          = {100899},
  doi          = {10.1016/j.gete.2026.100899},
  issn         = {2352-3808},
  langid       = {english},
  eprint       = {2606.20025},
  eprinttype   = {arxiv},
  keywords     = {planar3d, level-set, hydraulic-fracturing},
  indexing     = {TODO},
  abstract     = {Planar 3D models of hydraulic fracturing provide a practical balance between models with restrictive geometric assumptions and fully 3D simulators, capturing fractures with arbitrary planar footprints at moderate computational cost. Nevertheless, applications such as treatment design optimization and mini-frac test interpretation require large ensembles of simulations, for which the cost of planar 3D models remains a significant bottleneck. This work presents acceleration strategies for the planar 3D Implicit Level Set Algorithm (ILSA) to reduce simulation runtime while preserving numerical accuracy. A unified planar 3D ILSA scheme that consolidates the nested loops of the elastohydrodynamic solver and the front tracking algorithm into a single iterative process is introduced. A matrix splitting approach is applied to the linearized elastohydrodynamic system, moving the dense part of the elasticity operator to the right-hand side and yielding a sparse system matrix that can be solved more efficiently. Anderson acceleration is incorporated into the solution of the elastohydrodynamic system to improve convergence. A predictor--corrector scheme is additionally examined in combination with these methods. Each technique is evaluated individually and in combination on both the reference and unified schemes across five benchmark cases. Numerical experiments demonstrate that the unified scheme alone delivers an average 2.3x speed-up, reaching 3.8x for the Sandglass case. The combined application of all techniques achieves an average 4.2x speed-up and up to 14.4x for the Sandglass case. The schemes are also assessed during fracture closure, where the matrix splitting and Anderson acceleration prove most effective, together reaching up to 3.4x.},
  title_ru     = {Методы ускорения модели гидроразрыва planar 3D ILSA},
  abstract_ru  = {Модели гидроразрыва planar 3D обеспечивают практичный баланс между моделями с жёсткими геометрическими допущениями и полностью трёхмерными симуляторами: они описывают трещины произвольной формы в плоскости при умеренных вычислительных затратах. Тем не менее в таких задачах, как оптимизация дизайна обработки и интерпретация мини-ГРП, требуются большие серии расчётов, и стоимость моделей planar 3D остаётся узким местом. В работе предложены способы ускорить неявный алгоритм level set (ILSA) для модели planar 3D, сокращающие время расчёта при сохранении точности. Введена единая схема planar 3D ILSA, которая объединяет вложенные циклы эластогидродинамического решателя и алгоритма отслеживания фронта в один итерационный процесс. К линеаризованной эластогидродинамической системе применено расщепление матрицы: плотная часть оператора упругости переносится в правую часть, а разреженная матрица системы решается эффективнее. Для улучшения сходимости эластогидродинамической системы применено ускорение Андерсона. Дополнительно рассмотрена схема «предиктор — корректор» в сочетании с этими методами. Каждый приём оценён по отдельности и в комбинации, на эталонной и единой схемах, на пяти тестовых задачах. Численные эксперименты показывают, что одна только единая схема ускоряет расчёт в среднем в 2,3 раза (до 3,8 раза в случае Sandglass). Совместное применение всех методов даёт ускорение в среднем в 4,2 раза и до 14,4 раза в случае Sandglass. Схемы оценены и на стадии закрытия трещины, где наиболее эффективны расщепление матрицы и ускорение Андерсона: вместе они дают ускорение до 3,4 раза.},
  translation  = {auto}
}

@article{valov2023implicit,
  author       = {Valov, A. V. and Dontsov, E. V. and Baykin, A. N. and Golovin, S. V.},
  title        = {An implicit level set algorithm for hydraulic fracturing with a stress-layer asymptote},
  journal      = {Engineering Fracture Mechanics},
  year         = {2023},
  volume       = {292},
  eid          = {109662},
  doi          = {10.1016/j.engfracmech.2023.109662},
  issn         = {0013-7944},
  langid       = {english},
  eprint       = {2305.13714},
  eprinttype   = {arxiv},
  keywords     = {planar3d, level-set, hydraulic-fracturing, fracture-mechanics},
  indexing     = {wos, scopus, rinc},
  elibrary     = {64277101},
  abstract     = {The capability to simulate a hydraulic fracturing process is an essential tool that can be used to optimize treatment design and increase the efficiency of field operations. In most practical cases, hydraulic fractures propagate in a multi-layered rock formation. As a result, there is a need to incorporate the effect of such heterogeneities in fracturing models to achieve an accurate prediction. To capture the layered structure of rocks, a hydraulic fracture simulator typically requires a fine mesh, which leads to a drastic reduction in computational performance. An alternative is to use more sophisticated models that are capable of providing reasonably accurate predictions even on a relatively coarse mesh. In the case of fracture growth modeling, the pivotal component of the simulation is a fracture front tracking algorithm that accounts for the layered structure of the formation. Consequently, this paper aims to extend the established Implicit Level Set Algorithm (ILSA) to account for the effect of multiple stress layers within the tip asymptote. The enhanced front tracking algorithm involves the stress-corrected asymptote that incorporates the influence of stress layers within the near-tip region. To further increase the validity region of the stress-corrected asymptote, the stress relaxation factor is introduced, and its accuracy is examined. The numerical algorithm is validated against the reference semi-analytical solutions as well as experimental observations. In addition, we investigate the sensitivity of the fracture geometry to mesh size to demonstrate that the front tracking algorithm based on the stress-corrected asymptote retains its accuracy on a coarse mesh.},
  title_ru     = {Неявный алгоритм level set для гидроразрыва с асимптотикой, учитывающей слои напряжений},
  abstract_ru  = {Возможность моделировать гидроразрыв пласта — важный инструмент, позволяющий оптимизировать дизайн обработки и повышать эффективность промысловых операций. В большинстве практических случаев трещины гидроразрыва распространяются в многослойной породе, поэтому для точного прогноза модели гидроразрыва должны учитывать такие неоднородности. Чтобы отразить слоистое строение породы, симулятору гидроразрыва обычно нужна мелкая сетка, что резко снижает вычислительную производительность. Альтернатива — более сложные модели, дающие достаточно точный прогноз даже на сравнительно грубой сетке. Ключевой элемент моделирования роста трещины — алгоритм отслеживания её фронта, учитывающий слоистость пласта. Поэтому цель статьи — расширить известный неявный алгоритм level set (ILSA), чтобы учесть влияние нескольких слоёв напряжений в асимптотике у вершины трещины. Усовершенствованный алгоритм отслеживания фронта использует асимптотику с поправкой на напряжения, учитывающую слои напряжений в окрестности вершины. Чтобы расширить область применимости этой асимптотики, введён коэффициент релаксации напряжений и исследована его точность. Численный алгоритм проверен на эталонных полуаналитических решениях и экспериментальных данных. Кроме того, исследована чувствительность геометрии трещины к размеру сетки: показано, что алгоритм отслеживания фронта на основе асимптотики с поправкой на напряжения сохраняет точность на грубой сетке.},
  translation  = {auto}
}

@article{baykin2023twodimensional,
  author       = {Baykin, A. N. and Abdullin, R. F. and Dontsov, E. V. and Golovin, S. V.},
  title        = {Two-dimensional models for waterflooding induced hydraulic fracture accounting for the poroelastic effects on a reservoir scale},
  journal      = {Geoenergy Science and Engineering},
  year         = {2023},
  volume       = {224},
  eid          = {211600},
  doi          = {10.1016/j.geoen.2023.211600},
  issn         = {2949-8910},
  langid       = {english},
  eprint       = {4253987},
  eprinttype   = {ssrn},
  keywords     = {auto-frac, waterflooding, poroelasticity, fem},
  indexing     = {scopus, rinc},
  elibrary     = {55927606},
  abstract     = {This work focuses on the developing of a computationally efficient numerical model for a waterflooding induced planar hydraulic fracture in a poroelastic medium. In particular, under certain assumptions it is possible to decouple the fully coupled model into poroelastic reservoir and purely elastic fracture subproblems. Further, the general 3D problem formulation for a planar fracture is reduced to two dimensions for early time plane strain fracture and late time constant height fracture. Noticeably, the division of the problem into two subproblems allows us to use the displacement discontinuity approach for the fracture related part, and finite element method for the reservoir related part. The latter is especially important for the constant height fracture, which cannot be modeled using exclusively the finite element approach in two dimensions. The algorithm is benchmarked against the available analytical solutions, as well as compared to other numerical codes. The developed numerical method is used to study the influence of the heterogeneous pore pressure and the corresponding stress for different waterflooding fracturing situations. We consider the cases with both injection and production wells operating nearby. With the presence of such wells, the fracture growth becomes asymmetrical and both the well type and location are important. The qualitatively different fracture behavior is observed for various cases. Other numerical examples include the simulation of a step-rate test as well as investigation of the possibility of fracture control by altering the injection rate.},
  title_ru     = {Двумерные модели трещины авто-ГРП с учётом эффектов пороупругости в масштабе пласта},
  abstract_ru  = {Работа посвящена построению вычислительно эффективной численной модели плоской трещины авто-ГРП (трещины гидроразрыва, вызванной заводнением) в пороупругой среде. При определённых допущениях полностью связанную модель можно разделить на подзадачи для пороупругого пласта и для чисто упругой трещины. Далее общая трёхмерная постановка для плоской трещины сводится к двумерной: для трещины в условиях плоской деформации на ранних временах и для трещины постоянной высоты на поздних. Разделение на две подзадачи позволяет применять для трещины метод разрывных смещений, а для пласта — метод конечных элементов. Последнее особенно важно для трещины постоянной высоты, которую в двумерной постановке нельзя смоделировать одним лишь методом конечных элементов. Алгоритм проверен на известных аналитических решениях и сопоставлен с другими численными кодами. С помощью разработанного метода исследовано влияние неоднородного порового давления и соответствующих напряжений в разных ситуациях авто-ГРП, в том числе при работе соседних нагнетательных и добывающих скважин. При наличии таких скважин рост трещины становится несимметричным, и важны как тип скважины, так и её расположение; в разных случаях поведение трещины качественно различается. Среди других численных примеров — моделирование теста со ступенчатым изменением расхода (индикаторной кривой) и исследование возможности управлять трещиной, меняя расход закачки.},
  translation  = {auto}
}

