@inproceedings{golovin2017poroelastic,
  author       = {Golovin, S. V. and Baykin, A. N. and Valov, A. V.},
  title        = {Poroelastic Effects in the Hydraulic Fracturing},
  booktitle    = {Poromechanics VI: Proceedings of the Sixth Biot Conference on Poromechanics},
  publisher    = {American Society of Civil Engineers},
  year         = {2017},
  pages        = {1938--1942},
  doi          = {10.1061/9780784480779.240},
  langid       = {english},
  pubtype      = {proceedings},
  keywords     = {poroelasticity, hydraulic-fracturing},
  indexing     = {wos},
  abstract     = {Hydraulic fracturing is the process of creating a fracture due to pumping a highly pressurized fluid in a rock formation through a wellbore that is used for intensification of hydrocarbon production. Compared to the classical models of brittle fractures, hydraulic fracture theory describes the fluid flow within the fracture coupled with the fracture opening and propagation, exchange of the fracturing fluid with the pore fluid, influence of the pore pressure on the stresses, etc. In the talk we present our recent development in the modelling of the hydraulic fracture dynamics in a poroelastic medium. The topics include: a numerical algorithm for a simulation of the planar hydraulic fracture propagation in the Biot poroelastic medium; an analysis of the influence of the pore pressure on the dynamics of the fracture; use of non-stationary processes for the determination of fracture’s and reservoir’s parameters; estimation of the debit of a multiply fractured horizontal wellbore. The contents of the talk is based on the publications.},
  title_ru     = {Эффекты пороупругости при гидроразрыве пласта},
  abstract_ru  = {Гидроразрыв пласта — создание трещины в горной породе закачкой жидкости под высоким давлением через скважину; он применяется для интенсификации добычи углеводородов. В отличие от классических моделей хрупкого разрушения, теория гидроразрыва описывает течение жидкости в трещине совместно с её раскрытием и распространением, обмен жидкости гидроразрыва с поровой жидкостью, влияние порового давления на напряжения и т. д. В докладе представлены наши последние результаты в моделировании динамики трещины гидроразрыва в пороупругой среде: численный алгоритм расчёта распространения плоской трещины гидроразрыва в пороупругой среде Био; анализ влияния порового давления на динамику трещины; использование нестационарных процессов для определения параметров трещины и пласта; оценка дебита горизонтальной скважины с многостадийным гидроразрывом. Содержание доклада основано на опубликованных работах.},
  translation  = {auto}
}

